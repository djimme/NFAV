# API 키 템플릿 — 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요.
#   copy .env.example .env      (Windows)
# .env 는 .gitignore 에 등록돼 있어 커밋되지 않습니다.

# OPEN DART (https://opendart.fss.or.kr)
DART_API_KEY=

# KRX 정보데이터시스템 (data.krx.co.kr / data.go.kr)
KRX_API_KEY=

# KB증권 OpenAPI (https://github.com/kbsecurities/kb-openapi)
KB_APP_KEY=
KB_APP_SECRET=
KB_ACCOUNT_NO=
# real | mock  (모의투자 먼저)
KB_ENV=mock

# 한국투자증권 KIS OpenAPI (https://apiportal.koreainvestment.com)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_TYPE=01
# true | false (모의투자 여부)
KIS_PAPER=true
